<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.window-atlas" path="/org/gnome/shell/extensions/window-atlas/">
    <key name="show-indicator" type="b"><default>true</default><summary>Show the panel menu</summary></key>
